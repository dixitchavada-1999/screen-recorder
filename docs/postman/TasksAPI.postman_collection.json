            "type": "text/javascript",
            "exec": [
              "pm.test('answers with JSON and a request id', () => {",
              "  pm.response.to.have.header('X-Request-Id');",
              "});",
              "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
