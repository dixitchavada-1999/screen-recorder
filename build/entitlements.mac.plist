<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Electron runs V8, which writes and then executes machine code at runtime.
      Under the hardened runtime that is denied unless these three are granted.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!--
      FFmpeg ships as a separate binary inside the bundle and is spawned by the
      main process. Without this the loader refuses to run it alongside a
      hardened, differently-signed parent.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Microphone capture. Paired with NSMicrophoneUsageDescription. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Writing finished recordings to a folder the user picked. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
